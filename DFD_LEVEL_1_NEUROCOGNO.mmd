        Appointment[Appointment Form]
        CollabForm[Collaboration Enquiry Form]
        VisitorTracking[Visitor Event Tracking]
    end

    subgraph P2[2. Lead Capture And CRM]
        SurveyLead[Survey Lead Intake]
        DirectLead[Direct Appointment Lead Intake]
        DraftLead[Saved / Incomplete Draft Lead]
        CollabLead[Collaboration Request Intake]
        LeadActions[Search, Edit, Remarks, Confirm, Archive]
    end

    subgraph P3[3. Admin And RBAC]
        Login[Admin Login]
        RBAC[Role Checks: CEO, COO, Developer]
        Dashboard[Admin Dashboard Tabs]
        CMSAdmin[Website Media & Text CMS]
    end

    subgraph P4[4. Payment Pipeline]
        OrderCreate[Create Payment Order]
        Checkout[Client Checkout]
        Verify[Verify Signature / Webhook]
        PaymentState[Update Payment State]
    end

    subgraph P5[5. Monitoring And Logs]
        Health[Website Health & Traffic]
        Issues[Server / Payment / Upload Issues]
        Audit[Admin Change Audit Trail]
    end

    D1[(Admin Users)]
    D2[(Lead Records)]
    D3[(Payment Records)]
    D4[(Visitor Events)]
    D5[(System Issues)]
    D6[(Site Content / CMS Items)]
    D7[(Uploaded Media Files)]

    Visitor --> Routes
    Routes --> CMSRender
    CMSRender <--> D6
    CMSRender <--> D7
    Routes --> Survey
    Routes --> Appointment
    Routes --> CollabForm
    Routes --> VisitorTracking
