    SurveyLead --> D2
    DirectLead --> D2
    DraftLead --> D2
    CollabLead --> D2

    Admin --> Login
    Login --> D1
    Login --> RBAC
    RBAC --> Dashboard
    Dashboard --> LeadActions
    Dashboard --> CMSAdmin
    Dashboard --> Health
    Dashboard --> Issues

    LeadActions <--> D2
    CMSAdmin <--> D6
    CMSAdmin <--> D7
