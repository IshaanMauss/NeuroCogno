import React,{useEffect,useState}from'react';import{createRoot}from'react-dom/client';import{CalendarDays,Phone,Send,Sun,Moon,Users,ShieldCheck,UserRound,HeartPulse,Monitor,Mail,MapPin,ChevronDown,X,Sparkles,Leaf,Brain}from'lucide-react';import'./styles.css';
const navItems=[['/about-us','About Us'],['/neurocogno-insight','NeuroCogno Insight'],['/workshops-events','Workshops & Events'],['/collaborations','Collaboration'],['/services','Services']];
const fallback={ceoPhone:'+918976543210',email:'hello@neurocogno.com',emails:['info@neurocogno.com','support@neurocogno.com'],address:'Bangalore, India'};
const api={async r(p,o={}){let res=await fetch(p,{headers:{'Content-Type':'application/json',...(o.headers||{})},...o});let t=await res.text(),d=t?JSON.parse(t):{};if(!res.ok)throw new Error(d.message||'Request failed');return d},get(p){return this.r(p)},post(p,b){return this.r(p,{method:'POST',body:JSON.stringify(b)})}};
function visitorId(){let k='neurocogno_visitor_id',v=localStorage.getItem(k);if(!v){v='visitor_'+(crypto.randomUUID?crypto.randomUUID():Date.now().toString(36));localStorage.setItem(k,v)}return v}function track(e,m={}){api.post('/api/public/visitor-events',{visitorId:visitorId(),eventType:e,path:location.pathname,metadata:m}).catch(()=>{})}
function nav(p){history.pushState({},'',p);dispatchEvent(new PopStateEvent('popstate'));scrollTo({top:0,behavior:'smooth'});track('nav_click',{path:p})}function book(){history.pushState({},'','/about-us#booking');dispatchEvent(new PopStateEvent('popstate'));setTimeout(()=>document.getElementById('booking')?.scrollIntoView({behavior:'smooth'}),50)}
function routeNow(){return location.pathname==='/'?'/about-us':location.pathname}function useRoute(){let[r,setR]=useState(routeNow());useEffect(()=>{let f=()=>setR(routeNow());addEventListener('popstate',f);return()=>removeEventListener('popstate',f)},[]);return r}function useSeo(t){useEffect(()=>{document.title=t},[t])}
function Logo(){return <button className="logoButton" onClick={()=>nav('/about-us')}><span className="logoMark"><img src="/logo.png" alt="NeuroCogno logo"/></span><span><strong>NeuroCogno</strong><small>Mental Wellness & Counselling</small></span></button>}
function ThemeToggle({theme,onToggle}){let d=theme==='dark';return <button className={`themeToggle ${d?'active':''}`} onClick={onToggle} aria-label={d?'Switch to day mode':'Switch to night mode'}><span className="themeToggleOrb">{d?<Moon size={15}/>:<Sun size={15}/>}</span></button>}
function Header({contact,theme,onToggleTheme,route}){let active=navItems.find(([p])=>route===p||route.startsWith(p+'/'))?.[0]||'/about-us';return <header className="siteHeader"><Logo/><nav className="navLinks" aria-label="Main navigation">{navItems.map(([p,l])=><button key={p} className={active===p?'active':''} aria-current={active===p?'page':undefined} onClick={()=>nav(p)}>{l}</button>)}</nav><ThemeToggle theme={theme} onToggle={onToggleTheme}/><button className="primaryButton headerCta" onClick={book}><CalendarDays size={18}/>Book Appointment</button><a className="mobileCall" href={`tel:${contact.ceoPhone}`}><Phone size={18}/></a></header>}
function SectionTitle({title}){return <div className="sectionTitle"><h2>{title}</h2><span/></div>}
const help=[['Children','Learning difficulties','Behaviour concerns','Emotional support',HeartPulse],['Teenagers','Anxiety and stress','Confidence building','Academic pressure',Sparkles],['Adults','Stress management','Relationship issues','Emotional wellbeing',UserRound],['Seniors','Loneliness','Life transitions','Emotional support',Leaf],['Love & Relationships','Communication','Trust and understanding','Emotional connection',HeartPulse]];
const services=[['Counselling and Emotional Support','A confidential space for thoughts, emotions, relationships and repeated patterns with steady professional guidance.'],['Anxiety and Stress Management','Support for tension, restlessness, academic pressure, workplace fatigue and coping routines.'],['Parent Guidance and Child Support','Guidance for parents and caregivers supporting learning, behaviour and emotional needs.'],['Teen and Young Adult Wellbeing','Support for confidence, exams, social pressure, overwhelm and family expectations.'],['Workshops and Psychoeducation','Structured mental wellness sessions for schools, workplaces, parents and communities.']];
const insight=[['Parent Guidance','How Parents Can Notice Early Anxiety Signs'],['Care Ethics','Why Confidential Counselling Builds Trust'],['Mental Health','Simple Grounding Tools For Busy Adults'],['Teen Wellness','Managing Exam Stress With Calm Planning']];const collabs=[['Workplace Care','Corporate Emotional Wellness Workshop'],['Community Outreach','Community Mental Health Camp'],['Family Support','Parent Guidance Collaboration'],['Education Partner','School Wellness Awareness Program']];const events=[['Upcoming','School anxiety awareness drive','For students, parents and educators'],['Upcoming','Corporate stress management workshop','Workplace emotional resilience program'],['Planning','Parent-child communication session','Guided support for family systems'],['Planning','Mental wellbeing awareness camp','Community outreach and screening support']];
const popQs=[['What brings you to NeuroCogno today?',['I want support for myself','I am enquiring for my child','I am enquiring for family','I want guidance first']],['What would you like support with?',['Anxiety or stress','Mood and overthinking','Relationship or communication','Confidence or life transition']],['Who is seeking support?',['Child','Teenager','Adult','Senior']],['How soon would you like to begin?',['As soon as possible','This week','This month','Just exploring']],['Preferred mode of therapy',['Online','In-person','Either is fine']]];const checkQs=[['Which emotional pattern feels most present today?',['Anxiety or constant alertness','Low mood or emotional heaviness','Relationship confusion','Stress and burnout']],['What would you want the first session to clarify?',['What I am feeling','What support route fits me','How counselling works','How to support someone else']],['How intense has this been over the last few days?',['Mild but noticeable','Moderate and recurring','Difficult to manage','I am not sure']]];
function MiniSurvey({questions,onClose,onDone,callback=false}){let[step,setStep]=useState(0),[ans,setAns]=useState([]),[d,setD]=useState({name:'',phone:'',email:''});let q=questions[step],details=step>=questions.length;let add=a=>{setAns(x=>[...x,{question:q[0],answer:a}]);setStep(s=>s+1)};async function submit(e){e.preventDefault();if(callback)await api.post('/api/public/survey-callbacks',{visitorId:visitorId(),...d,answers:ans}).catch(()=>{});localStorage.setItem('neurocogno_popup_submitted_until',String(Date.now()+2592e6));onDone?.(ans);onClose?.()}return <div className="surveyOverlay"><div className="surveyModal"><button className="surveyClose" onClick={onClose}><X size={18}/></button>{!details?<><p className="eyebrow">A quiet check-in</p><h2>{q[0]}</h2><div className="surveyOptions">{q[1].map(o=><button key={o} onClick={()=>add(o)}>{o}</button>)}</div></>:<form onSubmit={submit}><p className="eyebrow">Request a callback</p><h2>Where should our team reach you?</h2><input required placeholder="Name" value={d.name} onChange={e=>setD({...d,name:e.target.value})}/><input required placeholder="Phone Number" value={d.phone} onChange={e=>setD({...d,phone:e.target.value})}/><input placeholder="Email Address" value={d.email} onChange={e=>setD({...d,email:e.target.value})}/><button className="primaryButton">Request Callback</button></form>}</div></div>}
function PopupSurvey(){let[v,setV]=useState(false);useEffect(()=>{if(Date.now()<+(localStorage.getItem('neurocogno_popup_closed_until')||0)||Date.now()<+(localStorage.getItem('neurocogno_popup_submitted_until')||0))return;let t=setTimeout(()=>setV(true),22000);return()=>clearTimeout(t)},[]);return v?<MiniSurvey questions={popQs} callback onClose={()=>{localStorage.setItem('neurocogno_popup_closed_until',String(Date.now()+864e5));setV(false)}} onDone={()=>setV(false)}/>:null}
function AppointmentForm({answers=[]}){let[f,setF]=useState({name:'',phone:'',email:'',ageGroup:'',reason:'',message:'',consentToContact:true}),[s,setS]=useState('');let u=(k,v)=>setF(x=>({...x,[k]:v}));useEffect(()=>{if(!f.name&&!f.phone&&!f.email)return;let t=setTimeout(()=>api.post('/api/public/lead-drafts',{...f,visitorId:visitorId(),source:'appointment_form'}).catch(()=>{}),800);return()=>clearTimeout(t)},[f]);async function sub(e){e.preventDefault();setS('Saving appointment request...');try{await api.post('/api/public/appointments',{...f,visitorId:visitorId(),source:'appointment_form',answers});setS('Appointment request saved. Our team will contact you.');setF({name:'',phone:'',email:'',ageGroup:'',reason:'',message:'',consentToContact:true})}catch(err){setS(err.message)}}return <form className="bookingForm" onSubmit={sub}><input required placeholder="Full Name" value={f.name} onChange={e=>u('name',e.target.value)}/><input required placeholder="Phone Number" value={f.phone} onChange={e=>u('phone',e.target.value)}/><input placeholder="Email Address" value={f.email} onChange={e=>u('email',e.target.value)}/><select required value={f.ageGroup} onChange={e=>u('ageGroup',e.target.value)}><option value="">Age Group</option><option>Child</option><option>Teenager</option><option>Adult</option><option>Senior</option></select><input required placeholder="Reason for Consultation" value={f.reason} onChange={e=>u('reason',e.target.value)}/><textarea placeholder="Your Message" value={f.message} onChange={e=>u('message',e.target.value)}/><button className="primaryButton">Request Appointment <Send size={18}/></button>{s&&<p className="formStatus">{s}</p>}</form>}
function Hero({contact}){return <section className="hero section"><div className="heroCopy"><p className="eyebrow">Compassionate. Confidential. Caring.</p><h1>Supporting Minds,<br/>Enriching <span>Lives.</span></h1><p className="heroText">Professional counselling and psychological support for children, teens, adults and seniors.</p><div className="heroActions"><button className="primaryButton" onClick={book}><CalendarDays size={18}/>Book Appointment</button><button className="outlineButton" onClick={()=>nav('/collaborations')}><Users size={18}/>Collab With Us</button><a className="outlineButton" href={`tel:${contact.ceoPhone}`}><Phone size={18}/>Connect With Team</a></div><div className="trustStrip"><span><ShieldCheck size={18}/>100% Confidential</span><span><UserRound size={18}/>Professional Care</span><span><HeartPulse size={18}/>Safe & Supportive</span><span><Monitor size={18}/>Online & In-Person</span></div></div><div className="heroVisual"><div className="therapyScene"><span className="wallFrame">you<br/>matter</span><span className="plant tall"/><span className="couch"/><span className="person client"/><span className="person counsellor"/></div></div></section>}
function About({contact}){useSeo('NeuroCogno | Mental Wellness & Counselling');let[a,setA]=useState([]),[open,setOpen]=useState(false);return <main><Hero contact={contact}/><section className="aboutBand section"><p className="eyebrow">Private, steady, human care</p><h2>Support designed around the person, not the problem label.</h2><p>NeuroCogno helps people speak openly, understand patterns and move toward practical wellbeing.</p></section><section className="whoSection section"><SectionTitle title="Who We Help"/><div className="helpGrid">{help.map(([t,a,b,c,I])=><article className="helpCard" key={t}><I size={34}/><h3>{t}</h3><ul><li>{a}</li><li>{b}</li><li>{c}</li></ul><button onClick={()=>nav('/services')}>Learn more</button></article>)}</div></section><section className="servicesBand section"><div><h2>Our Services</h2><div className="serviceIcons">{services.map(([t])=><button key={t} onClick={()=>nav('/services')}><Brain size={20}/>{t.split(' ')[0]}</button>)}</div></div><div><h2>How It Works</h2><div className="steps">{['Book Session','Initial Assessment','Personalised Plan','Regular Support','Improved Wellbeing'].map((x,i)=><span key={x}><CalendarDays size={20}/><b>{i+1}</b>{x}</span>)}</div></div></section><section className="booking section" id="booking"><div className="vaseVisual" aria-hidden="true"></div><div className="bookingCopy"><p className="eyebrow">Book an Appointment</p><h2>Take the first step towards a better tomorrow.</h2><ul><li>100% Confidential</li><li>Safe and supportive environment</li><li>Flexible scheduling</li></ul><button className="outlineButton" onClick={()=>setOpen(true)}><Sparkles size={18}/>Take a Gentle Self-Check</button></div><AppointmentForm answers={a}/></section>{open&&<MiniSurvey questions={checkQs} onClose={()=>setOpen(false)} onDone={setA}/>}<Testimonials/><Faq/><PopupSurvey/></main>}
function Moving({title,kicker,items,id}){return <section className="marqueeSection section" id={id}><p className="eyebrow">{kicker}</p><h2>{title}</h2><div className="marqueeViewport"><div className="marqueeTrack">{[...items,...items].map(([k,n],i)=><article className="marqueeCard" key={n+i}><div className="marqueeImage"/><small>{k}</small><h3>{n}</h3></article>)}</div></div></section>}
function Insight(){useSeo('NeuroCogno Insight Hub');return <main><section className="pageHero section"><p className="eyebrow">Knowledge, media, updates</p><h1>NeuroCogno Insight Hub</h1><p>A dedicated space for blogs, podcasts, expert articles, educational resources, news updates, photos and video-led learning.</p></section><Moving title="Insight Photo Wall" kicker="Blogs, stories, resources" items={insight} id="insights"/><section className="insightGrid section">{['Blogs','Podcasts','Expert Articles','News & Updates','Resources','Photo Stories'].map(x=><article key={x}><h3>{x}</h3><p>Space for NeuroCogno {x.toLowerCase()} and approved educational content.</p></article>)}</section><section className="videoLearningPanel section"><div><p className="eyebrow">Video learning space</p><h2>YouTube education video embed</h2><p>Approved YouTube videos can play directly on the website here.</p></div><div className="videoFrame"><Monitor size={38}/><strong>Video Embed Space</strong></div></section><PageLinks current="/neurocogno-insight"/></main>}
function Workshops(){useSeo('Workshops & Events | NeuroCogno');return <main><section className="pageHero section"><p className="eyebrow">Upcoming workshops and event calendar</p><h1>Workshops & Events</h1><p>Designed for schools, workplaces, parents, educators and communities.</p></section><section className="eventGrid section">{events.map(([s,t,d])=><article className="eventCard" key={t}><div className="marqueeImage"><CalendarDays/></div><small>{s}</small><h3>{t}</h3><p>{d}</p></article>)}</section><PageLinks current="/workshops-events"/></main>}
function Collaboration(){useSeo('Collaborate With NeuroCogno');let[f,setF]=useState({name:'',organization:'',phone:'',email:'',collaborationType:'',message:'',consentToContact:false}),[s,setS]=useState('');let u=(k,v)=>setF(x=>({...x,[k]:v}));async function sub(e){e.preventDefault();setS('Sending collaboration enquiry...');try{await api.post('/api/public/collaboration-inquiries',{...f,visitorId:visitorId()});setS('Collaboration enquiry saved. Our team will contact you.')}catch(err){setS(err.message)}}return <main><section className="collabHero"><p className="eyebrow">Partnerships, workshops, awareness drives</p><h1>Collaborate with NeuroCogno</h1><p>Schools, workplaces, communities and care groups can partner with NeuroCogno for mental wellness programs, counselling awareness, events and guided support sessions.</p><div className="collabHeroActions"><button className="primaryButton" onClick={()=>document.getElementById('collab-enquiry')?.scrollIntoView({behavior:'smooth'})}><Send size={18}/>Send Collaboration Enquiry</button><button className="outlineButton" onClick={()=>document.getElementById('collab-gallery')?.scrollIntoView({behavior:'smooth'})}><Users size={18}/>View Collaboration Wall</button><button className="outlineButton" onClick={()=>document.getElementById('events')?.scrollIntoView({behavior:'smooth'})}><CalendarDays size={18}/>Upcoming Events</button></div></section><Moving title="Recent Collaborations" kicker="Live collaboration wall" items={collabs} id="collab-gallery"/><section className="collabDetails section"><div><h2>What We Can Build Together</h2><p>Awareness talks, school programs, workplace wellness sessions, community camps and specialised support circles.</p></div><div className="detailGrid">{['School Programs','Corporate Workshops','Community Camps','Parent Guidance','Event Partnerships','Referral Networks'].map(x=><article key={x}>{x}</article>)}</div></section><section className="eventsSection section" id="events"><SectionTitle title="Upcoming Events"/><div className="eventGrid">{events.map(([s,t,d])=><article key={t}><span>{s}</span><h3>{t}</h3><p>{d}</p></article>)}</div></section><section className="collabEnquiry section" id="collab-enquiry"><div><h2>Collaboration Enquiry</h2><p>Share organisation details and the mental wellness partnership you want to explore.</p></div><form onSubmit={sub} className="bookingForm"><input required placeholder="Full Name" value={f.name} onChange={e=>u('name',e.target.value)}/><input required placeholder="Organisation" value={f.organization} onChange={e=>u('organization',e.target.value)}/><input required placeholder="Phone Number" value={f.phone} onChange={e=>u('phone',e.target.value)}/><input placeholder="Email Address" value={f.email} onChange={e=>u('email',e.target.value)}/><input required placeholder="Collaboration Type" value={f.collaborationType} onChange={e=>u('collaborationType',e.target.value)}/><textarea required placeholder="Message" value={f.message} onChange={e=>u('message',e.target.value)}/><label><input type="checkbox" checked={f.consentToContact} onChange={e=>u('consentToContact',e.target.checked)}/> I agree to be contacted by NeuroCogno.</label><button className="primaryButton">Submit Enquiry</button>{s&&<p className="formStatus">{s}</p>}</form></section><PageLinks current="/collaborations"/></main>}
function Services(){useSeo('NeuroCogno Services');return <main><section className="pageHero section"><p className="eyebrow">Professional care areas</p><h1>NeuroCogno Services</h1><p>Support for people, families, students, parents, schools and organizations.</p><div className="heroActions"><button className="primaryButton" onClick={book}>Book Appointment</button><button className="outlineButton" onClick={()=>nav('/neurocogno-insight')}>Check Our Insight Hub</button></div></section><section className="serviceDoc section">{services.map(([t,d])=><article key={t}><h2>{t}</h2><p>{d}</p><ul><li>Practical care planning</li><li>Confidential support</li><li>Clear next steps</li></ul></article>)}</section><Testimonials/><Faq/><PageLinks current="/services"/></main>}
function Testimonials(){return <section className="section"><SectionTitle title="What People Usually Value"/><div className="testimonials">{['The sessions helped us understand the concern calmly and take practical next steps.','The guidance felt structured, respectful and easy to follow between sessions.','The workshop language was simple, warm and useful for both parents and students.'].map(t=><article key={t}><span>*****</span><p>{t}</p><strong>- NeuroCogno client feedback</strong></article>)}</div></section>}
function Faq(){return <section className="faqList section"><SectionTitle title="General Service Questions"/>{['Which service should I choose first?','Can counselling be online?','Is this only for serious mental health concerns?','Can parents enquire for a child or teenager?','Do workshops need to be customised?'].map(q=><details key={q}><summary>{q}<ChevronDown size={16}/></summary><p>Our team will understand the concern first and suggest the most suitable next step.</p></details>)}</section>}
function PageLinks({current}){return <section className="pageLinks section"><p className="eyebrow">Explore NeuroCogno</p><h2>Move through the site without losing context.</h2><div>{navItems.filter(([p])=>p!==current).map(([p,l])=><button key={p} onClick={()=>nav(p)}><strong>{l}</strong><span>{p==='/about-us'?'Meet NeuroCogno and book an appointment':p==='/collaborations'?'Partnerships for schools, workplaces and communities':p==='/services'?'Counselling and mental wellness support areas':p==='/workshops-events'?'Upcoming programs and awareness sessions':'Blogs, education, videos and resources'}</span></button>)}</div></section>}
function Footer({contact}){return <footer className="footer"><div><Logo/><p>Empowering minds. Enriching lives.</p></div><div><h3>Quick Links</h3>{navItems.map(([p,l])=><button key={p} onClick={()=>nav(p)}>{l}</button>)}</div><div><h3>Contact Us</h3><p><Phone size={15}/> {contact.ceoPhone}</p>{(contact.emails||[contact.email]).map(e=><p key={e}><Mail size={15}/> {e}</p>)}<p><MapPin size={15}/> {contact.address}</p></div><div><h3>Direct Support</h3><button onClick={()=>nav('/collaborations')}><Users size={15}/> Collab With Us</button><a href={`tel:${contact.ceoPhone}`}><Phone size={15}/> Connect with Team</a></div></footer>}
function App(){let route=useRoute(),[theme,setTheme]=useState(localStorage.getItem('neurocogno_theme')||'light'),[contact,setContact]=useState(fallback);useEffect(()=>{document.documentElement.dataset.theme=theme;localStorage.setItem('neurocogno_theme',theme)},[theme]);useEffect(()=>{api.get('/api/public/config').then(c=>setContact(c.contact||fallback)).catch(()=>{});track('page_view',{route})},[route]);let page=route==='/neurocogno-insight'?<Insight/>:route==='/workshops-events'?<Workshops/>:route==='/collaborations'?<Collaboration/>:route==='/services'?<Services/>:<About contact={contact}/>;return <><Header contact={contact} theme={theme} onToggleTheme={()=>setTheme(t=>t==='dark'?'light':'dark')} route={route}/>{page}<Footer contact={contact}/><a className="floatingHelp" href={`tel:${contact.ceoPhone}`}><Phone size={20}/><span>Need help?<b>Connect with team</b></span></a></>}
createRoot(document.getElementById('root')).render(<App/>);