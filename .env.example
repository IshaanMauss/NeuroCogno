# ===================================================================
# NEUROCOGNO BACKEND CONFIGURATION
# ===================================================================
# IMPORTANT: Never commit the actual .env file to version control
# This is a template. Copy to .env and fill in real values.
# ===================================================================

# Environment (development, test, production)
NODE_ENV=development
PORT=8080

# Frontend URLs (Update for production)
CLIENT_ORIGIN=http://127.0.0.1:5173
PUBLIC_BASE_URL=http://127.0.0.1:5173

# ===================================================================
# DATABASE CONFIGURATION
# ===================================================================
# For local development:
# MONGODB_URI=mongodb://127.0.0.1:27017/neurocogno
#
# For MongoDB Atlas (Production):
MONGODB_URI=mongodb+srv://ishaan.dev.work555@gmail.com:<db_password>@cluster0.pqokmy2.mongodb.net/?appName=Cluster0
MONGODB_DB_NAME=neurocogno

# ===================================================================
# SECURITY SECRETS
# ===================================================================
# CRITICAL: Generate strong random values before production deployment
# Use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Access tokens (short-lived, 20 minutes)
JWT_ACCESS_SECRET=replace-with-64-char-random-secret

# Refresh tokens (long-lived, 7 days)
JWT_REFRESH_SECRET=replace-with-another-64-char-random-secret

# Cookie signing secret
COOKIE_SECRET=replace-with-cookie-secret

# ===================================================================
# ADMIN USER CONFIGURATION
# ===================================================================
# Seeded admin accounts for initial setup
# CRITICAL: Change passwords immediately after first login
# Format: JSON array of user objects
# Roles: ceo, coo, developer
#
ADMIN_USERS_JSON=[{"name":"Ishaan","username":"ishaan","email":"ishaan@neurocogno.local","password":"555879","role":"developer"},{"name":"CEO","username":"ceo","email":"ceo@neurocogno.local","password":"555879","role":"ceo"},{"name":"COO","username":"coo","email":"coo@neurocogno.local","password":"555879","role":"coo"}]

# ===================================================================
# PAYMENT GATEWAY CONFIGURATION
# ===================================================================
# Razorpay integration (default for India)
# Get keys from: https://dashboard.razorpay.com/
#
# Test Mode Keys (for development):
# RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXX
# RAZORPAY_KEY_SECRET=YYYYYYYYYYYYYYYYYYYY
#
# Live Mode Keys (for production):
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Booking amount in INR (paise will be calculated server-side)
BOOKING_AMOUNT_INR=499

# ===================================================================
# BUSINESS INFORMATION
# ===================================================================
# Contact details displayed in UI and used for communication
CEO_PHONE=+918976543210
BUSINESS_EMAIL=hello@neurocogno.com
INFO_EMAIL=info@neurocogno.com
SUPPORT_EMAIL=support@neurocogno.com
BUSINESS_ADDRESS=123, Green Avenue, Bangalore, India

# ===================================================================
# PRODUCTION DEPLOYMENT NOTES
# ===================================================================
#
# Before deploying to production:
#
# 1. SECURITY SECRETS
#    - Generate new JWT_ACCESS_SECRET (64+ characters)
#    - Generate new JWT_REFRESH_SECRET (64+ characters)
#    - Generate new COOKIE_SECRET (32+ characters)
#    - Never reuse development secrets
#
# 2. DATABASE
#    - Use MongoDB Atlas or managed MongoDB
#    - Rotate database password
#    - Restrict IP access to production server only
#    - Enable database backups
#
# 3. ENVIRONMENT
#    - Set NODE_ENV=production
#    - Update CLIENT_ORIGIN to production domain
#    - Update PUBLIC_BASE_URL to production domain
#    - Ensure HTTPS is enabled
#
# 4. ADMIN ACCOUNTS
#    - Replace all temporary passwords
#    - Use strong passwords (8+ chars, mixed case, numbers, symbols)
#    - Use real email addresses
#    - Remove unused admin accounts
#
# 5. PAYMENT GATEWAY
#    - Add live Razorpay keys (not test keys)
#    - Configure webhook URL in Razorpay dashboard
#    - Set RAZORPAY_WEBHOOK_SECRET from Razorpay
#    - Test payment flow thoroughly
#
# 6. MONITORING
#    - Set up error tracking (Sentry, etc.)
#    - Configure uptime monitoring
#    - Set up log aggregation
#    - Configure security alerts
#
# 7. INFRASTRUCTURE
#    - Enable HTTPS/SSL certificates
#    - Configure firewall rules
#    - Set up CDN for static assets
#    - Configure load balancer if needed
#
# ===================================================================


# Cloudinary (CMS image storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
